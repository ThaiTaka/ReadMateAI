# ReadMate AI — biến môi trường MẪU.
# Sao chép thành .env.local và điền giá trị trên máy của bạn. KHÔNG commit .env.local (đã có trong .gitignore).
# Biến có tiền tố NEXT_PUBLIC_ sẽ lộ ra trình duyệt: tuyệt đối không đặt secret ở đó.
# Máy dev: `npm run db:start` rồi `npm run db:env` sẽ tự tạo .env.local với khóa của Supabase LOCAL (docs/SUPABASE_SETUP.md).
# Thiếu cấu hình Supabase: trang công khai và /demo vẫn chạy; đăng nhập GV và /join báo "chưa cấu hình".

# --- Ứng dụng ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (R03) — CHỈ khóa kiểu mới sb_publishable_… / sb_secret_…; khóa JWT anon/service_role cũ bị từ chối ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ phía server, bỏ qua RLS:
SUPABASE_SECRET_KEY=

# --- Thẻ học: pepper cho HMAC mã truy cập (R03), chỉ phía server, ≥ 32 ký tự ngẫu nhiên ---
# Đổi pepper = mọi thẻ học đang có mất hiệu lực (phải cấp lại).
LOGIN_CODE_PEPPER=

# --- Chỉ máy dev: mật khẩu của 2 tài khoản GV GIẢ do npm run db:seed tạo (npm run db:env sinh ngẫu nhiên) ---
SEED_TEACHER_PASSWORD=

# --- Bảo vệ route tác vụ định kỳ (GĐ5+), chỉ phía server ---
CRON_SECRET=

# --- Chuyển văn bản thành tiếng (GĐ6): none | google | azure | ... ---
TTS_PROVIDER=none

# --- AI hỗ trợ giáo viên tạo bản nháp (GĐ11): none | anthropic ---
# Ứng dụng phải chạy đầy đủ khi AI_PROVIDER=none.
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- CAPTCHA cho trang /join (production, trước khi dùng thật — chưa hiện thực ở R03) ---
TURNSTILE_SECRET_KEY=
