# ReadMate AI — biến môi trường MẪU.
# Sao chép thành .env.local và điền giá trị trên máy của bạn. KHÔNG commit .env.local (đã có trong .gitignore).
# Biến có tiền tố NEXT_PUBLIC_ sẽ lộ ra trình duyệt: tuyệt đối không đặt secret ở đó.
# Ở Giai đoạn 2 ứng dụng chưa đọc biến nào — các biến dưới đây dành cho các giai đoạn sau.

# --- Ứng dụng ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (GĐ5) — dùng khóa publishable/secret mới, không dùng anon/service_role cũ ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ phía server, bỏ qua RLS:
SUPABASE_SECRET_KEY=

# --- Thẻ học: pepper cho HMAC mã truy cập (GĐ5), chỉ phía server ---
LOGIN_CODE_PEPPER=

# --- Bảo vệ route tác vụ định kỳ (GĐ5+), chỉ phía server ---
CRON_SECRET=

# --- Chuyển văn bản thành tiếng (GĐ6): none | google | azure | ... ---
TTS_PROVIDER=none

# --- AI hỗ trợ giáo viên tạo bản nháp (GĐ11): none | anthropic ---
# Ứng dụng phải chạy đầy đủ khi AI_PROVIDER=none.
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- CAPTCHA cho trang /join (production, GĐ10) ---
TURNSTILE_SECRET_KEY=
