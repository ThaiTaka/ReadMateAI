# Chuẩn hóa xuống dòng LF trong repository (máy Windows đang bật core.autocrlf=true)
* text=auto eol=lf

# Script Windows giữ CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Tệp nhị phân
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.mp3 binary
*.m4a binary
*.aac binary
*.ogg binary
*.opus binary
*.wav binary
*.webm binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
